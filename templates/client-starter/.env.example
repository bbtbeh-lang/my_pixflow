# Pixflow Client Starter — Environment Variables Template
# این فایل فقط نمونه است. برای هر مشتری، مقادیر واقعی را مستقیم در
# Environment Variables پنل Render همان سرویس وارد کنید — هرگز در گیت‌هاب کامیت نشود.

PORT=3000
NODE_ENV=production

# ایمیل و رمز ورود پنل ادمین — به‌ازای هر مشتری یکتا و تصادفی تولید شود
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

# برای امضای session — یک رشته‌ی تصادفی طولانی و یکتا برای هر مشتری
SESSION_SECRET=CHANGE_ME_RANDOM_STRING

# Supabase — هم برای دیتابیس (db.js) و هم آپلود فایل (routes/upload.js).
# دیتای لوکال روی Render تیر رایگان با هر ری‌استارت پاک می‌شه، پس این‌ها
# اجباری‌اند. برای هر مشتری یک پروژه‌ی Supabase جدا (تیر رایگان) بساز.
# راهنما: docs/SUPABASE_SETUP.md
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=pixflow-uploads
