# Copy this file to .env for local development.
# On Render, set these under Environment (not in a committed file).

# Session
SESSION_SECRET=replace-with-a-long-random-string

# Supabase (replaces the old local db.json — see docs/SUPABASE_SETUP.md)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Cloudflare R2 (replaces local /data/uploads — see docs/SUPABASE_SETUP.md)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pixflow-uploads
R2_PUBLIC_URL=
