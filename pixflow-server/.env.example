# Copy this file to .env for local development.
# On Render, set these under Environment (not in a committed file).

# Session
SESSION_SECRET=replace-with-a-long-random-string

# First admin account — created automatically by seed.js on startup if no
# admin user exists yet. Password must be at least 10 characters.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Admin

# Supabase — used for BOTH the database (db.js) and file storage
# (routes/upload.js). See docs/SUPABASE_SETUP.md.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=pixflow-uploads

# Email notifications for new contact/order messages (optional — if unset,
# messages still save normally, you just won't get an email alert).
# See docs/EMAIL_NOTIFICATIONS_SETUP.md.
RESEND_API_KEY=
# NOTIFY_EMAIL=you@example.com   # defaults to ADMIN_EMAIL if not set

# AI chat widget (optional — if unset, the widget still shows but replies
# with a friendly "use the Contact form" fallback instead of crashing).
# See docs/CHATBOT_SETUP.md.
GEMINI_API_KEY=
